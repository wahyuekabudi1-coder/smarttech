# ==============================================================================
# SMART TECH INDONESIA - ENVIRONMENT CONFIGURATION TEMPLATE
# Model Bisnis: Lead Generation & Konsultasi (Tanpa Sistem Pembayaran Online)
# ==============================================================================
# Salin file ini menjadi .env atau masukkan ke dalam Vercel Project Settings > Environment Variables
# PERINGATAN: Jangan pernah memasukkan file .env atau secret key asli ke dalam repositori git.

# Server & Node Runtime
PORT=3000
NODE_ENV=production

# Database Configuration (PostgreSQL / Supabase / Neon / Vercel Postgres)
# Prioritas Utama: Seluruh leads, follow-up, konsultasi, klien, proposal, dan proyek
# akan otomatis tersimpan dan tersinkronisasi ke PostgreSQL saat DATABASE_URL tersedia.
# Pada development lokal tanpa PostgreSQL, sistem menggunakan file JSON lokal.
DATABASE_URL=postgresql://postgres:[PASSWORD]@[HOST]:5432/[DATABASE]?sslmode=require
POSTGRES_URL=
SUPABASE_DB_URL=

# Modul ArtoPay (Opsional - Khusus Studi Kasus / Test Suite Demo)
# Catatan: Seluruh layanan Smart Tech TIDAK memerlukan pembayaran online.
# Variabel berikut hanya diperlukan untuk pengujian unit adapter ArtoPay.
ARTOPAY_ENV=sandbox
ARTOPAY_SANDBOX=true
ARTOPAY_API_KEY=your_sandbox_api_key
ARTOPAY_SECRET_KEY=your_sandbox_secret_key
ARTOPAY_BASE_URL=https://api-sandbox.artopay.id/v1
ARTOPAY_SANDBOX_BASE_URL=https://api-sandbox.artopay.id/v1
ARTOPAY_PROD_BASE_URL=https://api.artopay.id/v1

# Security & Simulation Guard (Khusus Sandbox Pengujian Unit)
ADMIN_SIMULATION_KEY=your_sandbox_admin_key